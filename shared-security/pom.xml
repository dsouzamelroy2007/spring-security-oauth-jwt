<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>com.mel.expensetracker</groupId>
    <artifactId>expense-tracker-parent</artifactId>
    <version>0.1.0-SNAPSHOT</version>
  </parent>

  <artifactId>shared-security</artifactId>
  <packaging>jar</packaging>

  <name>Expense Tracker - Shared Security</name>
  <description>Reusable auto-configuration: RFC 9457 errors, JWT converters, audit, org resolution. Library only, no Boot repackaging.</description>

  <dependencies>
    <!-- Library, not an application: every servlet/security dependency is
         optional and consumed behind @ConditionalOnClass, so an application
         module that doesn't need JWT resource-server support (e.g. a future
         module using only the RFC 9457 handlers) isn't forced to pull it in. -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-security-oauth2-resource-server</artifactId>
      <optional>true</optional>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-webmvc</artifactId>
      <optional>true</optional>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-autoconfigure</artifactId>
      <optional>true</optional>
    </dependency>
    <!-- [FEATURE D8] Backs AuditEventWriter. Optional: a module with no
         database connection of its own never pulls this in, and never gets
         an AuditEventWriter bean (see AuditAutoConfiguration). -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-jdbc</artifactId>
      <optional>true</optional>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>
    <!-- spring-security-test alone no longer makes @WithMockUser work; this
         starter is required alongside it (same pattern as authorization-server). -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-security-test</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>
</project>
