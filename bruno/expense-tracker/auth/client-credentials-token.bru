meta {
  name: client_credentials token (export-worker)
  type: http
  seq: 1
}

post {
  url: {{authServer}}/oauth2/token
  body: formUrlEncoded
  auth: basic
}

auth:basic {
  username: export-worker
  password: export-worker-secret
}

body:form-urlencoded {
  grant_type: client_credentials
  scope: expenses.export
}
