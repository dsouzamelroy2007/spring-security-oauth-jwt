<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>com.mel.expensetracker</groupId>
    <artifactId>expense-tracker-parent</artifactId>
    <version>0.1.0-SNAPSHOT</version>
  </parent>

  <artifactId>authorization-server</artifactId>
  <packaging>jar</packaging>

  <name>Expense Tracker - Authorization Server</name>
  <description>OIDC Provider: issuer metadata, JWKS, form login, consent. The only module that authenticates humans.</description>

  <dependencies>
    <!-- [FEATURE D8] AuditEventWriter, wired into FormLoginSuccessHandler /
         FormLoginFailureHandler below. -->
    <dependency>
      <groupId>com.mel.expensetracker</groupId>
      <artifactId>shared-security</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-webmvc</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-actuator</artifactId>
    </dependency>
    <!-- Spring Authorization Server: issuer metadata, JWKS, /oauth2/* endpoints.
         Brings spring-boot-starter-security and Nimbus JOSE transitively. -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-security-oauth2-authorization-server</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-thymeleaf</artifactId>
    </dependency>
    <!-- JPA for the user store; also brings spring-boot-starter-jdbc, used
         directly by JdbcRegisteredClientRepository / JdbcOAuth2AuthorizationService. -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-data-jpa</artifactId>
    </dependency>
    <dependency>
      <groupId>org.postgresql</groupId>
      <artifactId>postgresql</artifactId>
      <scope>runtime</scope>
    </dependency>
    <!-- Boot 4 split FlywayAutoConfiguration out of the monolithic autoconfigure
         jar into this starter; flyway-core alone (no starter) silently gets no
         autoconfiguration at all: migrations never run, no error, no log line. -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-flyway</artifactId>
    </dependency>
    <!-- Flyway 10+ split DB support out of flyway-core; without this,
         startup fails with "Unsupported Database: PostgreSQL". -->
    <dependency>
      <groupId>org.flywaydb</groupId>
      <artifactId>flyway-database-postgresql</artifactId>
      <scope>runtime</scope>
    </dependency>
    <!-- Keeps the "6" suffix on Spring Security 7; no ...springsecurity7 exists. -->
    <dependency>
      <groupId>org.thymeleaf.extras</groupId>
      <artifactId>thymeleaf-extras-springsecurity6</artifactId>
    </dependency>
    <!-- Backs Argon2PasswordEncoder at runtime; never imported directly. -->
    <dependency>
      <groupId>org.bouncycastle</groupId>
      <artifactId>bcprov-jdk18on</artifactId>
      <scope>runtime</scope>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>
    <!-- spring-security-test alone no longer enables @WithMockUser; this starter
         is required alongside it. -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-security-test</artifactId>
      <scope>test</scope>
    </dependency>
    <!-- No testcontainers-junit-jupiter: AbstractIntegrationTest deliberately
         doesn't use @Testcontainers/@Container (see its class comment). -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-testcontainers</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.testcontainers</groupId>
      <artifactId>testcontainers-postgresql</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
      </plugin>
    </plugins>
  </build>
</project>
